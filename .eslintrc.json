{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "script"
    },
    "globals": {
        "DarDZ": "readonly",
        "WILAYAS": "readonly",
        "LOGEMENTS": "readonly",
        "lottie": "readonly",
        "escapeHTML": "readonly",
        "escapeAttr": "readonly"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "eqeqeq": ["error", "always"],
        "curly": ["error", "all"],
        "semi": ["error", "always"],
        "quotes": ["warn", "single", { "avoidEscape": true }],
        "indent": ["warn", 4, { "SwitchCase": 1 }],
        "no-trailing-spaces": "warn",
        "comma-dangle": ["warn", "never"],
        "no-multiple-empty-lines": ["warn", { "max": 2 }],
        "no-var": "error",
        "prefer-const": "warn",
        "no-implicit-globals": "off",
        "no-undef": "warn"
    },
    "ignorePatterns": [
        "node_modules/",
        "animations/",
        "*.min.js"
    ]
}
